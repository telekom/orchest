  "properties": [
    {
      "name": "alerting.default-resend-interval-ms",
      "type": "java.lang.Long",
      "description": "Default interval between re-notifications for FIRING alerts (milliseconds).",
      "sourceType": "io.telekom.orchest.alerting.ModuleProperties",
      "defaultValue": 300000
    },
    {
      "name": "alerting.enabled",
      "type": "java.lang.Boolean",
      "description": "Whether alerting is enabled.",
      "sourceType": "io.telekom.orchest.alerting.ModuleProperties",
      "defaultValue": false
    },
    {
      "name": "alerting.scheduler.enabled",
      "type": "java.lang.Boolean",
      "description": "When true, this process runs the alert notification poller.",
      "sourceType": "io.telekom.orchest.alerting.ModuleProperties$Scheduler",
      "defaultValue": false
    },
    {
      "name": "alerting.scheduler.poll-interval-ms",
      "type": "java.lang.Long",
      "description": "How often the poller looks for due FIRING alerts (milliseconds).",
      "sourceType": "io.telekom.orchest.alerting.ModuleProperties$Scheduler",
      "defaultValue": 30000
